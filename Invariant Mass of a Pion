#include <iostream>
#include <cmath>

// ROOT Header Files
#include "TFile.h"
#include "TTree.h"
#include "TH1F.h"
#include "TF1.h"
#include "TH1D.h"
#include "TCanvas.h"
#include "TFitResult.h"
#include "TApplication.h"
#include "TRandom.h"
#include "TMath.h"
#include "TStyle.h"

// Pythia Header File (Needed to interpret the event objects)
#include "Pythia8/Pythia.h"

using namespace Pythia8;

int main(int argc, char* argv[]) {

  // Create the ROOT application environment
  TApplication theApp("hist", &argc, argv);

  TFile* inFile = TFile::Open("pytree.root", "READ");
  if (!inFile || inFile->IsZombie()) {
    std::cerr << "Error: Could not open pytree.root!" << std::endl;
    return 1;
  }

  // 2. Extract the Data Tree
  TTree* tree = (TTree*)inFile->Get("GAM");
  TTree* tree2 = (TTree*)inFile->Get("m");

  // 3. Initialize the Canvas and the E Histogram
  TCanvas* c1 = new TCanvas("c1", "Pythia Analysis", 1200, 600);
  TCanvas* c2 = new TCanvas("c2", "Pythia Analysis", 1200, 600);
  TCanvas* c3 = new TCanvas("c3", "Pythia Analysis", 1200, 600);
  TCanvas* c5 = new TCanvas("c5", "Pythia Analysis", 1200, 600);
  TCanvas* c6 = new TCanvas("c6", "Pythia Analysis", 1200, 600);
  c3->Divide(4,5);
  c6->Divide(4,5);
  TH1F* mHist = new TH1F("mHist", "Invariant Mass;M [GeV];Entries", 100, 0.0, 1.0);
  TH1F* m1Hist = new TH1F("m1Hist", "Smeared Invariant Mass;M [GeV];Entries", 100, 0.0, 1.0);
  TH1F* FittedHist1 = new TH1F("FittedHist1", "Fitted Smeared Invariant Mass;M [GeV];Entries", 100, 0.0, 1.0);
  
  TH1F* m2Hist[20];
  for (int i = 0; i < 20; ++i) {
    double pT_low = 0.2 + (i * 0.5);
    double pT_high = pT_low + 0.5;
    std::string name = "pTHist_" + std::to_string(i);
    std::string title = "Smeared M (#pi^{0}) for " + std::to_string(pT_low).substr(0,3) + " < p_{T} < " + std::to_string(pT_high).substr(0,3) + " GeV;M [GeV];Entries";
    m2Hist[i] = new TH1F(name.c_str(), title.c_str(), 100, 0.0, 1.0);
  }

  TH1F* FittedHist2[20];
  for (int i = 0; i < 20; ++i) {
    double pT_low = 0.2 + (i * 0.5);
    double pT_high = pT_low + 0.5;
    std::string name = "pTHist_Fit_" + std::to_string(i);
    std::string title = "Smeared M (#pi^{0}) for " + std::to_string(pT_low).substr(0,3) + " < p_{T} < " + std::to_string(pT_high).substr(0,3) + " GeV;M [GeV];Entries";
    FittedHist2[i] = new TH1F(name.c_str(), title.c_str(), 100, 0.0, 1.0);
  }
  // 4. set up placeholder variables to read data back out of the tree
  Long64_t nEvents = tree->GetEntries();
  std::vector<double> *e_vector = nullptr;
  std::vector<double> *px_vector = nullptr;
  std::vector<double> *py_vector = nullptr;
  std::vector<double> *pz_vector = nullptr;
  std::vector<double> *pT_vector = nullptr;
  
  tree->SetBranchAddress("e", &e_vector);
  tree->SetBranchAddress("px", &px_vector);
  tree->SetBranchAddress("py", &py_vector);
  tree->SetBranchAddress("pz", &pz_vector);
  tree->SetBranchAddress("pT", &pT_vector);

  //5. Loop over all simulated events inside the ROOT tree
  for (Long64_t i = 0; i < nEvents; ++i) {
    tree->GetEntry(i);
    size_t nPhotons = e_vector->size();
    for (size_t j = 0; j < nPhotons; ++j) {
      for (size_t k = j + 1; k < nPhotons; ++k) {
        //
        // Calculate perfect invatiant mass of photon pairs
        //
        double e_sum = (*e_vector)[j] + (*e_vector)[k];
        double px_sum = (*px_vector)[j] + (*px_vector)[k];
        double py_sum = (*py_vector)[j] + (*py_vector)[k];
        double pz_sum = (*pz_vector)[j] + (*pz_vector)[k];
        // M^2 = E^2 - |p|^2
        double M1 = (e_sum * e_sum) - (px_sum * px_sum + py_sum * py_sum + pz_sum * pz_sum); // perfect invariant mass
        if (M1 >= 0) {
        mHist->Fill(sqrt(M1));
        } // avoiding negative roots
        
        //
        // adding acceptance cuts and energy smearing
        // pseudoraptidity eta = -ln(tan(theta/2)) where theta = arccos(pz/pr) and is bounded by -1.7<eta<1.3
        // gaussian smearing of energy sigma = 0.053 * E / sqrt(E)
        //

        double e_j = (*e_vector)[j]; //individual photons
        double px_j = (*px_vector)[j];
        double py_j = (*py_vector)[j];
        double pz_j = (*pz_vector)[j];
        double p_j = sqrt(px_j*px_j + py_j*py_j + pz_j*pz_j);
        double theta_j = acos(pz_j / p_j);
        double eta_j = -log(tan(theta_j / 2.0));
        
        double e_k = (*e_vector)[k]; 
        double px_k = (*px_vector)[k];
        double py_k = (*py_vector)[k];
        double pz_k = (*pz_vector)[k]; 
        double p_k = sqrt(px_k*px_k + py_k*py_k + pz_k*pz_k);
        double theta_k = acos(pz_k / p_k);
        double eta_k = -log(tan(theta_k / 2.0));
        
        if (eta_j < -1.7 || eta_j > 1.3) continue; // acceptance cuts
        if (eta_k < -1.7 || eta_k > 1.3) continue;
        
        double sigma_j = 0.053 * e_j / sqrt(e_j);  // smearing and momentum accounting
        double smeared_e_j = gRandom->Gaus(e_j, sigma_j);
        double ratio_j = smeared_e_j / e_j;
        double smeared_px_j = ratio_j * px_j;
        double smeared_py_j = ratio_j * py_j;
        double smeared_pz_j = ratio_j * pz_j;
        
        double sigma_k = 0.053 * e_k / sqrt(e_k); 
        double smeared_e_k = gRandom->Gaus(e_k, sigma_k);
        double ratio_k = smeared_e_k / e_k;
        double smeared_px_k = ratio_k * px_k;
        double smeared_py_k = ratio_k * py_k;
        double smeared_pz_k = ratio_k * pz_k;
        
        double e_sum_sm = smeared_e_j + smeared_e_k; // sum
        double px_sum_sm = smeared_px_j + smeared_px_k;
        double py_sum_sm = smeared_py_j + smeared_py_k;
        double pz_sum_sm = smeared_pz_j + smeared_pz_k;
        
        double M2 = (e_sum_sm * e_sum_sm) - (px_sum_sm * px_sum_sm + py_sum_sm * py_sum_sm + pz_sum_sm * pz_sum_sm);
        if (M2 < 0) continue; // Skip negative mass roots
        m1Hist->Fill(sqrt(M2)); // Fill histogram 2 with the smeared invariant mass
        FittedHist1->Fill(sqrt(M2));

        
        //
        // 20 histograms of smeared invariant masses from pT of 0.2-10.2GeV in 0.5 GeV increments
        //
        double pT_val = sqrt(px_sum_sm * px_sum_sm + py_sum_sm * py_sum_sm);
        int histIndex = static_cast<int>((pT_val - 0.2) / 0.5);
        if (pT_val >= 0.2 && pT_val < 10.2) {
          m2Hist[histIndex]->Fill(sqrt(M2));
          FittedHist2[histIndex]->Fill(sqrt(M2));
        }
      }
    }
  }

  
  // 6. Compare to accepted mass of pion
  double accepted_mass = 0.135; //comparison to accepted mass of pion
  
  double selected_mass = mHist->GetBinCenter(mHist->GetMaximumBin());
  double deviation = std::abs(selected_mass - accepted_mass);
  std::cout << "Perfect mass peak: " << selected_mass << " GeV (Dev: " << (deviation/accepted_mass)*100.0 << "%)\n";

  double smear_selected_mass = m1Hist->GetBinCenter(m1Hist->GetMaximumBin());
  double smear_deviation = std::abs(smear_selected_mass - accepted_mass);
  std::cout << "Smeared mass peak: " << smear_selected_mass << " GeV (Dev: " << (smear_deviation/accepted_mass)*100.0 << "%)\n";

  // 7. Fit the distributions with a Gaussian + Quadratic function to extract mass, width, and yield
  
  //
  // Fit the smeared distribution
  //
  
  TF1 *smeared_fit_func = new TF1("smeared_fit_func", "gaus(0) + pol2(3)", 0.05, 0.30);
  
  double smeared_max_height = FittedHist1->GetMaximum(); // Height of the peak
  smeared_fit_func->SetParameter(0, smeared_max_height * 0.7); // Guess signal height (leaving room for background)
  smeared_fit_func->SetParameter(1, 0.135); // Guess mean near true mass
  smeared_fit_func->SetParameter(2, 0.012); // Guess width
  
  TFitResultPtr smeared_fit_res = FittedHist1->Fit(smeared_fit_func, "SRQ");
  
  if (smeared_fit_res.Get() != nullptr && smeared_fit_res->IsValid()) {
    double amp   = smeared_fit_res->Parameter(0);
    double mass  = smeared_fit_res->Parameter(1);
    double sigma = smeared_fit_res->Parameter(2);
    double yield = amp * sigma * sqrt(2 * M_PI) / FittedHist1->GetBinWidth(1); // Normalized by bin width
    
    std::cout << "Extracted Mass:  " << mass << " GeV\n";
    std::cout << "Extracted Width: " << sigma << " GeV\n";
    std::cout << "Calculated Yield:" << yield << " pions\n";
  }

  //
  //gaussian and quadratic fits for the pT-binned graphs, focusing on width, mean, and yield.
  //
  TF1* saved_fits[20] = {nullptr};

  for (int i = 0; i < 20; ++i) {
    std::string fit_name = "fit_pT_" + std::to_string(i);
    saved_fits[i] = new TF1(fit_name.c_str(), "gaus(0) + pol2(3)", 0.00, 0.25);
         
    saved_fits[i]->SetParName(0, "Gauss scale");
    saved_fits[i]->SetParName(1, "Gauss #mu");
    saved_fits[i]->SetParName(2, "Gauss #sigma");
    saved_fits[i]->SetParName(3, "Bkg0");
    saved_fits[i]->SetParName(4, "Bkg1");
    saved_fits[i]->SetParName(5, "Bkg2");         
    
    // Guess parameters
    double bin_max = FittedHist2[i]->GetMaximum();
    saved_fits[i]->SetParameter(0, bin_max * 0.15); 
    saved_fits[i]->SetParameter(1, 0.135);          
    saved_fits[i]->SetParameter(2, 0.012);                    
    saved_fits[i]->SetParLimits(1, 0.110, 0.160);   
    saved_fits[i]->SetParLimits(2, 0.003, 0.035);   

    // CHANGE: Added "N" to the fit options string
    TFitResultPtr bin_res = FittedHist2[i]->Fit(saved_fits[i], "SRQ"); 

    if (bin_res.Get() != nullptr && bin_res->IsValid()) {
      double amp   = bin_res->Parameter(0);
      double sigma = bin_res->Parameter(2);
      double yield = amp * sigma * sqrt(2 * M_PI) / FittedHist2[i]->GetBinWidth(1);

      // CHANGE: Applied styling properties directly to the array element
      saved_fits[i]->SetLineColor(kRed);
      saved_fits[i]->SetLineWidth(2);
    } else {
      // CHANGE: Clean up failed fits safely
      delete saved_fits[i];
      saved_fits[i] = nullptr;
    }
  }

  // 7. Draw and save plots
  c1->cd();
  mHist->Draw();
  c1->SaveAs("/Users/lucashill/Downloads/Python/Klay_Lab_Work/PionMass.png");

  c2->cd();
  m1Hist->Draw();
  c2->SaveAs("/Users/lucashill/Downloads/Python/Klay_Lab_Work/SmearedPionMass.png");

  // --- Fit and Draw the Smeared Distribution (c5) ---
  c5->cd();

  // Enable the fit parameters in the stats box (Chi2/ndf, Prob, Values, Errors)
  gStyle->SetOptFit(1111);
  gStyle->SetOptStat(0);  // Hide hist stats for all sub-pads

  FittedHist1->Draw();

  TF1 *smeared_fit_func_1 = new TF1("smeared_fit_func_1", "gaus(0) + pol2(3)", 0.05, 0.30);

  // Name the parameters so they appear beautifully in the stats box
  smeared_fit_func_1->SetParName(0, "Gauss scale");
  smeared_fit_func_1->SetParName(1, "Gauss #mu");
  smeared_fit_func_1->SetParName(2, "Gauss #sigma");
  smeared_fit_func_1->SetParName(3, "Bkg0");
  smeared_fit_func_1->SetParName(4, "Bkg1");
  smeared_fit_func_1->SetParName(5, "Bkg2");

  double smeared_max_height_1 = FittedHist1->GetMaximum();
  smeared_fit_func_1->SetParameter(0, smeared_max_height_1 * 0.7); 
  smeared_fit_func_1->SetParameter(1, 0.135); 
  smeared_fit_func_1->SetParameter(2, 0.012); 

  // Fit the histogram (remove "Q" if you want to see the terminal output log)
  TFitResultPtr smeared_fit_res_1 = FittedHist1->Fit(smeared_fit_func_1, "SR");

  if (smeared_fit_res_1.Get() != nullptr && smeared_fit_res_1->IsValid()) {
    // 1. Extract and draw the Quadratic Background component (Red)
    TF1 *bg_c5 = new TF1("bg_c5", "pol2", 0.05, 0.30);
    bg_c5->SetParameter(0, smeared_fit_func_1->GetParameter(3));
    bg_c5->SetParameter(1, smeared_fit_func_1->GetParameter(4));
    bg_c5->SetParameter(2, smeared_fit_func_1->GetParameter(5));
    bg_c5->SetLineColor(kRed);
    bg_c5->Draw("same");
    
    // 2. Extract and draw the Gaussian Signal component (Green)
    TF1 *sig_c5 = new TF1("sig_c5", "gaus", 0.05, 0.30);
    sig_c5->SetParameter(0, smeared_fit_func_1->GetParameter(0));
    sig_c5->SetParameter(1, smeared_fit_func_1->GetParameter(1));
    sig_c5->SetParameter(2, smeared_fit_func_1->GetParameter(2));
    sig_c5->SetLineColor(kGreen+2); 
    sig_c5->Draw("same");

    // 3. Set Total Fit to Blue and draw it
    smeared_fit_func_1->SetLineColor(kBlue);
    smeared_fit_func_1->SetLineWidth(2);
    smeared_fit_func_1->Draw("same");
  }

  c5->Modified();
  c5->Update(); // Forces ROOT to draw the updated stats box immediately
  c5->SaveAs("/Users/lucashill/Downloads/Python/Klay_Lab_Work/FittedSmearedPionMass.png");


  for (int i = 0; i < 20; ++i) {
    c3->cd(i + 1);
    m2Hist[i]->Draw();
  }
  c3->SaveAs("/Users/lucashill/Downloads/Python/Klay_Lab_Work/pT_bins_invariant_mass.png");

  c6->Clear();
  c6->Divide(5, 4); 

  // Ensure fit options are globally enabled for all sub-pads
  gStyle->SetOptFit(1111);
  gStyle->SetOptStat(0);  // Hide hist stats for all sub-pads

  for (int i = 0; i < 20; ++i) {
    c6->cd(i + 1); 
    
    // Drawing the histogram first generates the base stats box layout
    FittedHist2[i]->Draw();
    
    if (saved_fits[i] != nullptr) {
      // 1. Draw Red Background component
      TF1 *bg_component = new TF1(Form("bg_%d", i), "pol2", 0.00, 0.25);
      bg_component->SetParameter(0, saved_fits[i]->GetParameter(3));
      bg_component->SetParameter(1, saved_fits[i]->GetParameter(4));
      bg_component->SetParameter(2, saved_fits[i]->GetParameter(5));
      bg_component->SetLineColor(kRed);
      bg_component->Draw("same");
      
      // 2. Draw Green Signal component
      TF1 *sig_component = new TF1(Form("sig_%d", i), "gaus", 0.00, 0.25);
      sig_component->SetParameter(0, saved_fits[i]->GetParameter(0));
      sig_component->SetParameter(1, saved_fits[i]->GetParameter(1));
      sig_component->SetParameter(2, saved_fits[i]->GetParameter(2));
      sig_component->SetLineColor(kGreen+2);
      sig_component->Draw("same");
      
      // 3. Draw Total Fit in Blue
      saved_fits[i]->SetLineColor(kBlue);
      saved_fits[i]->SetLineWidth(2);
      saved_fits[i]->Draw("same");
    }
  }
  c6->Modified();
  c6->Update();
  c6->SaveAs("/Users/lucashill/Downloads/Python/Klay_Lab_Work/Fitted_pT_bins_invariant_mass.png");

  std::cout << "Close the graphical windows to exit the application.\n";
  theApp.Run(); 

  //9. Close and clean
  inFile->Close();
  delete inFile;
  delete c1;
  delete c2;
  delete c3;
  delete c5;
  delete c6;
  delete mHist;
  delete m1Hist;
  delete FittedHist1;
  for (int i = 0; i < 20; ++i) {delete FittedHist2[i];}
  for (int i = 0; i < 20; ++i) {delete m2Hist[i];}
  return 0;
}



